{
  "name": "saiki",
  "version": "1.0.1",
  "description": "再起 Saiki - Planificador de carga cognitiva y resiliencia personal",
  "main": "main.js",
  "author": {
    "name": "Saiki",
    "email": "saiki.planificador@gmail.com"
  },
  "homepage": "https://github.com/rodpino71-expert/Saiki",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodpino71-expert/Saiki.git"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:dominio": "esbuild src/dominio/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/dominio/index.js",
    "dist": "electron-builder",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.saiki.app",
    "productName": "Saiki",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/licencia/*.js",
      "package.json",
      "dist/**"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "synopsis": "再起 Saiki - Volver a empezar",
      "description": "Planificador de carga cognitiva y resiliencia personal"
    },
    "deb": {
      "depends": ["libnotify4", "libxtst6", "libnss3"],
      "maintainer": "Saiki <saiki.planificador@gmail.com>"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.61.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
